# Supabase PostgreSQL connection string — Session Pooler.
# Use the Session Pooler connection details from the Supabase Dashboard.
# Never put real credentials in this file; keep them in backend/.env.
#
# Session Pooler uses the postgres.<project-ref> username format and port 5432.
DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:<password>@<pooler-host>:5432/postgres
# Comma-separated frontend origins.
CORS_ORIGINS=http://localhost:5173
